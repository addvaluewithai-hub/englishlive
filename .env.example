# Web builds may leave this empty to call /api on the same origin.
# Native builds must set it to the public HTTPS origin hosting Englotti APIs.
VITE_API_BASE_URL=

# Public Neon Auth endpoint. This is not a secret; the app has a production fallback.
# Set this when testing against a different Neon branch/auth endpoint.
VITE_NEON_AUTH_URL=

# Server-side Cloudflare secret. Never expose this as VITE_*.
# Configure it in Cloudflare Pages/Workers secrets for live voice sessions.
GEMINI_API_KEY=

# Server-side Cloudflare secret used by /api/content/*, /api/me/* and /api/studio to reach Neon Postgres.
# Never expose this as VITE_* and never commit a real connection string.
DATABASE_URL=

# Optional server-side override for JWT verification when auth is moved to another Neon branch.
# The production JWKS URL is used by default.
NEON_AUTH_JWKS_URL=

# Server-side Englotti Studio allowlist. At least one allowlist must be configured or Studio denies access.
# Comma-separated Neon Auth account emails, e.g. owner@example.com,editor@example.com
STUDIO_ADMIN_EMAILS=

# Optional alternative/additional allowlist using exact Neon Auth user ids.
STUDIO_ADMIN_USER_IDS=
